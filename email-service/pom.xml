<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>dev.leilaalgarve.jogoacoes</groupId>
  <artifactId>email-service</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>email-service</name>
  <description>
    Serviço de E-mail (spec 05-025) -- cadastro de templates sincronizado com o Amazon SES.
    Mesma versão de parent/Java/Spring Cloud AWS/Cucumber/REST Assured de `app/pom.xml`, por
    consistência (ver plan.md).
  </description>

  <properties>
    <java.version>21</java.version>
    <cucumber.version>7.34.6</cucumber.version>
    <junit-platform.version>6.1.3</junit-platform.version>
    <rest-assured.version>6.0.1</rest-assured.version>
    <spring-cloud-aws.version>4.1.0</spring-cloud-aws.version>
    <!-- Spec 05-042: same Spring Cloud release train as app/pom.xml, for the config client. -->
    <spring-cloud.version>2025.1.3</spring-cloud.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.awspring.cloud</groupId>
        <artifactId>spring-cloud-aws-dependencies</artifactId>
        <version>${spring-cloud-aws.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Spec 05-042: per-environment configuration comes from config-server (spring.config.import
         in application.yml). spring-retry lets the client retry that startup read, a GET;
         same version spring-cloud-config-client builds against (optional there). -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.retry</groupId>
      <artifactId>spring-retry</artifactId>
      <version>2.0.13</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Required by the @Valid/@NotNull annotations the openapi-generator-maven-plugin puts
         on the generated request DTOs/controller interface (spring generator). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- T002: only used for the SesClient bean it autoconfigures (same credentials/region/
         endpoint-override property shape app/pom.xml already uses for SQS); the higher-level
         MailSender abstraction this starter also provides is never used, since it has no
         CreateTemplate/UpdateTemplate/TestRenderTemplate operations (see plan.md). -->
    <dependency>
      <groupId>io.awspring.cloud</groupId>
      <artifactId>spring-cloud-aws-starter-ses</artifactId>
    </dependency>

    <!-- Spec 05-031, T004: publishes send requests to the SQS send queue with SqsTemplate, same
         pattern as app's SqsEmailSender. -->
    <dependency>
      <groupId>io.awspring.cloud</groupId>
      <artifactId>spring-cloud-aws-starter-sqs</artifactId>
    </dependency>

    <!-- T003: TestRenderTemplate's response is a raw MIME string (plan.md), parsed into
         subject/body with Jakarta Mail instead of hand-rolled parsing. -->
    <dependency>
      <groupId>jakarta.mail</groupId>
      <artifactId>jakarta.mail-api</artifactId>
      <version>2.1.5</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.angus</groupId>
      <artifactId>angus-mail</artifactId>
      <version>2.0.5</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Spec 05-030: real API-KEY validation (lalgarve/api-key, release v1.1.0, with per-key
         permissions since spec 05-048). Not on Maven
         Central nor on a registry this build reads: scripts/install-api-key-lib.sh installs it
         into ~/.m2 from the GitHub release first (plan.md, "Como distribuir api-key-validation
         para o build"). Only the auth package may use it (ArchitectureTest). -->
    <dependency>
      <groupId>dev.leilaalgarve.apikey</groupId>
      <artifactId>api-key-validation</artifactId>
      <version>1.1.0</version>
    </dependency>

    <!-- Spec 05-048: the disposable-domain list import (Job, Steps, reader/processor/writer) and
         its JDBC job repository, whose tables Flyway creates in schema email_service. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-batch-jdbc</artifactId>
    </dependency>

    <!-- Spec 05-047: MX/A/AAAA lookups of the recipient's domain against a configurable DNS
         server (docker: the CoreDNS test zone). Tells "domain does not exist" apart from "no such
         record" and from "no answer", which the JDK's JNDI DNS provider folds into exceptions. -->
    <dependency>
      <groupId>dnsjava</groupId>
      <artifactId>dnsjava</artifactId>
      <version>3.6.4</version>
    </dependency>

    <!-- Spec 05-049: interactive Swagger UI against the static docs/openapi-email-service.yaml
         contract, the same library and version as app's (spec 05-009). springdoc.packages-to-scan
         in application.yml keeps it from generating a second contract from the annotations. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>3.1.1</version>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Spec 05-030, T001: same version as app/pom.xml. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.5.0</version>
      <scope>test</scope>
    </dependency>

    <!-- T004 -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-spring</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <version>${junit-platform.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>${rest-assured.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Required by the code the openapi-generator-maven-plugin produces (spring generator). -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations</artifactId>
      <version>2.2.53</version>
    </dependency>
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <version>0.2.11</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Spec 05-034: email-service never depends on app's jar, not even transitively. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-other-service</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>dev.leilaalgarve.jogoacoes:jogo-acoes</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <!-- Spec 05-049: copies the same docs/openapi-email-service.yaml the generator below reads
             into target/classes/static as openapi.yaml, so Swagger UI (springdoc.swagger-ui.url)
             serves the real contract at /api/openapi.yaml, the same address as app's. Antrun
             rather than maven-resources-plugin (app's way) because the file is renamed. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>copy-openapi-contract-for-swagger-ui</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <copy file="${project.basedir}/../docs/openapi-email-service.yaml"
                      tofile="${project.build.outputDirectory}/static/openapi.yaml"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.24.0</version>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <!-- docs/ lives at the repo root, shared across modules; see pom.xml at the
                   root for why. -->
              <inputSpec>${project.basedir}/../docs/openapi-email-service.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <library>spring-boot</library>
              <apiPackage>dev.leilaalgarve.jogoacoes.emailservice.api</apiPackage>
              <modelPackage>dev.leilaalgarve.jogoacoes.emailservice.api.model</modelPackage>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useTags>true</useTags>
                <dateLibrary>java8</dateLibrary>
                <useSpringBoot3>true</useSpringBoot3>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <configuration>
          <excludes>
            <exclude>dev/leilaalgarve/jogoacoes/emailservice/api/**</exclude>
            <exclude>org/openapitools/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
