target/
*.class

# email-lambda-builder's output handoff to localstack (docker-compose.yml) -- deliberately not
# email-lambda/target itself, so the root-owned build inside that container never shares a
# directory with the host/CI's own (non-root) `mvn test` against email-lambda.
email-lambda/dist/
.idea/
*.iml
.vscode/

# LaTeX build artifacts (docs/disciplina) -- PDF is generated at delivery
# time (decision: separate branch), not committed alongside the .tex source.
docs/disciplina/*.aux
docs/disciplina/*.log
docs/disciplina/*.out
docs/disciplina/*.toc
docs/disciplina/*.lof
docs/disciplina/*.lot
docs/disciplina/*.bbl
docs/disciplina/*.blg
docs/disciplina/*.synctex.gz
docs/disciplina/*.pdf

# blackbox-tests/ (spec 05-015) -- Python project, generated client and local venv aren't
# committed: the client is regenerated from docs/openapi.yaml (source of truth), same spirit
# as target/generated-sources on the Java side not being committed either.
blackbox-tests/generated_client/
blackbox-tests/.venv/
blackbox-tests/__pycache__/
blackbox-tests/**/__pycache__/
blackbox-tests/.pytest_cache/
blackbox-tests/*.egg-info/
